# 複製成 .env 後填入真實值：cp .env.example .env
# .env 已被 .gitignore 排除，永遠不要提交真實金鑰。

# --- 資料庫 ---
POSTGRES_USER=twf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twfinance
DATABASE_URL=postgresql://twf:change-me@localhost:5432/twfinance

# --- 盤後資料（services/worker）---
# https://finmindtrade.com/ 註冊後取得，可將額度由 300 提高到 600 次/小時
FINMIND_TOKEN=

# --- 即時行情（services/quote-gateway）---
# https://developer.fugle.tw/ 申請
FUGLE_API_KEY=
QUOTE_GATEWAY_PORT=8787
# 前端連線用（瀏覽器可見，請勿放金鑰）
NEXT_PUBLIC_QUOTE_WS_URL=ws://localhost:8787

# --- AI 摘要 ---
ANTHROPIC_API_KEY=

# --- 通知（擇一）---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
